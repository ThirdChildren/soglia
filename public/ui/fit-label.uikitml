<div id="fit-label-root" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 44; background-color: #ffffff; border-radius: 2.5; border-width: 0.8; border-color: #6b6f76; padding-top: 1.6; padding-bottom: 1.6; padding-left: 2.2; padding-right: 2.2;">
  <span id="fit-label-text" style="font-size: 2.4; font-weight: bold; color: #1a1a1a; line-height: 1.25; text-align: center;">-</span>
  <span id="fit-label-note" style="font-size: 2.4; font-weight: normal; color: #3a3d42; line-height: 1.25; text-align: center; margin-top: 0.8;">-</span>
</div>
