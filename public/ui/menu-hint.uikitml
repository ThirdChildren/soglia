<div id="menu-hint-root" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 38; background-color: #ffffff; border-radius: 2.5; border-width: 0.4; border-color: #1a1a1a; padding-top: 1.2; padding-bottom: 1.2; padding-left: 2; padding-right: 2;">
