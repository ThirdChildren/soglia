<div id="issue-panel-root" style="display: flex; flex-direction: column; align-items: center; width: 36; height: 37.6;">
  <div id="issue-panel-title-box" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 36; height: 4; background-color: #ffffff; border-radius: 2; border-width: 0.4; border-color: #1a1a1a;">
    <span id="issue-panel-title" style="font-size: 2.6; font-weight: bold; color: #1a1a1a; line-height: 1.1; text-align: center;">-</span>
  </div>
  <div id="issue-panel-body" style="display: flex; flex-direction: column; align-items: center; justify-content: flex-end; width: 36; height: 26.6; margin-top: 0.4; background-color: #ffffff; border-radius: 2; border-width: 0.4; border-color: #1a1a1a;">
    <span id="issue-panel-footer" style="font-size: 2.4; font-weight: normal; color: #3a3f47; line-height: 1.1; text-align: center; margin-bottom: 1;">-</span>
  </div>
  <div id="issue-panel-bar" style="display: flex; flex-direction: row; justify-content: space-between; width: 36; height: 6.2; margin-top: 0.4;">
    <div id="issue-panel-back" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 9; height: 6.2; background-color: #ffffff; border-radius: 2; border-width: 0.4; border-color: #1a1a1a;">
      <span id="issue-panel-back-label" style="font-size: 2.4; font-weight: bold; color: #1a1a1a; line-height: 1.1; text-align: center;">-</span>
    </div>
    <div id="issue-panel-close" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 9; height: 6.2; background-color: #ffffff; border-radius: 2; border-width: 0.4; border-color: #1a1a1a;">
      <span id="issue-panel-close-label" style="font-size: 2.4; font-weight: bold; color: #1a1a1a; line-height: 1.1; text-align: center;">-</span>
    </div>
  </div>
</div>
