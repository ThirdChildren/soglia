<div id="scan-card-root" style="display: flex; flex-direction: column; align-items: center; width: 30; height: 18.4; background-color: #ffffff; border-radius: 2.5; border-width: 0.4; border-color: #1a1a1a; padding-top: 1.2; padding-bottom: 1.2; padding-left: 1.2; padding-right: 1.2;">
  <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 27.6; height: 4.4;">
    <span id="scan-card-title" style="font-size: 3.6; font-weight: bold; color: #1a1a1a; line-height: 1.2; text-align: center;">-</span>
  </div>
  <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 27.6; height: 4; margin-top: 0.6;">
    <span id="scan-card-measures" style="font-size: 2.8; color: #1a1a1a; line-height: 1.2; text-align: center;">-</span>
  </div>
  <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 0.6; width: 27.6; height: 6.2; margin-top: 0.8;">
    <div id="scan-card-add" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 17; height: 6.2; background-color: #1f4fd8; border-radius: 2; border-width: 0.4; border-color: #1a1a1a;">
      <span id="scan-card-add-text" style="font-size: 2.4; font-weight: bold; color: #ffffff; line-height: 1.25; text-align: center;">-</span>
    </div>
    <div id="scan-card-close" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 9.5; height: 6.2; background-color: #e3e9f3; border-radius: 2; border-width: 0.4; border-color: #1a1a1a;">
      <span id="scan-card-close-text" style="font-size: 2.4; font-weight: bold; color: #1a1a1a; line-height: 1.25; text-align: center;">-</span>
    </div>
  </div>
</div>
