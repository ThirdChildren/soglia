{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soglia.local/schemas/issue.schema.json",
  "title": "Soglia issues file",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "houseId",
      "kind",
      "position",
      "category",
      "urgency",
      "text",
      "history"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "houseId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "kind": {
        "enum": [
          "issue",
          "question",
          "baseline",
          "info"
        ]
      },
      "position": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "fixtureId": {
        "type": "string"
      },
      "category": {
        "enum": [
          "plumbing",
          "electrical",
          "appliances",
          "furniture",
          "floors_walls",
          "windows_doors",
          "other"
        ]
      },
      "urgency": {
        "enum": [
          "low",
          "medium",
          "urgent"
        ]
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "audio": {
        "type": "string"
      },
      "status": {
        "enum": [
          "open",
          "in_progress",
          "resolved",
          "archived"
        ]
      },
      "history": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "by",
            "event"
          ],
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "by": {
              "enum": [
                "tenant",
                "landlord",
                "agent",
                "visitor"
              ]
            },
            "event": {
              "enum": [
                "created",
                "in_progress",
                "resolved",
                "archived",
                "reopened",
                "commented"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "if": {
      "properties": {
        "kind": {
          "const": "issue"
        }
      }
    },
    "then": {
      "required": [
        "status"
      ]
    },
    "else": {
      "not": {
        "required": [
          "status"
        ]
      }
    }
  }
}
